# Development defaults. On a server set APP_ENV=production, the domain below, and real secrets.
APP_ENV=development
# The address people reach the app at. It is printed into every QR code, so set it before
# printing cards. On a server: https://photos.example.com
PUBLIC_BASE_URL=http://localhost:8010
# On a server: the domain alone (photos.example.com), so Caddy obtains its HTTPS certificate, and
# HTTP_BIND=80 / HTTPS_BIND=443 to publish the standard ports. Point the domain's DNS at the server.
# SITE_ADDRESS=photos.example.com
# HTTP_BIND=80
# HTTPS_BIND=443
# The password that opens the photographer's workspace. Outside development it must be at least
# 12 characters; changing it signs every browser out.
PHOTOGRAPHER_PASSWORD=people-local
# Signs session cookies and links. Outside development: 32+ random characters,
# for example the output of `openssl rand -hex 32`.
SECRET_KEY=local-only-change-this-before-any-public-deployment-7dfc23
# local keeps files under STORAGE_ROOT. r2 stores them in a Cloudflare R2 bucket and needs the four R2_ values.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DEFAULT_LOCALE=en
# Optional. Shown in the page footers and the FAQ.
CONTACT_EMAIL=
